"""$summary.

The public API ($Module) is re-exported lazily, via module `__getattr__`
(PEP 562), rather than imported eagerly here. Python always runs a
package's `__init__.py` before importing any of its submodules (including
`dfwb_plugin`), so an eager import here -- pulled in transitively by
`modules` -- would defeat `dfwb_plugin.py`'s own promise not to need torch
at module level: the framework's plugin discovery loads
`dfwb_torch_$module.dfwb_plugin` for every installed plugin before deciding
whether to import a target class (`target` is a "lazy import path"). torch
is only imported the first time `$Module` is actually accessed.
"""

from typing import TYPE_CHECKING, Any

if TYPE_CHECKING:  # pragma: no cover - type-checking only, never executed
    from dfwb_torch_$module.modules import $Module as $Module

__version__ = "0.1.0"

__all__ = ["$Module", "__version__"]

# name -> (submodule, attribute); the submodule is only imported on first use.
_LAZY: dict[str, tuple[str, str]] = {
    "$Module": ("dfwb_torch_$module.modules", "$Module"),
}


def __getattr__(name: str) -> Any:
    """Resolve a lazy re-export on first access, then cache it on the module.

    Example:
        >>> from dfwb_torch_$module import $Module
        >>> $Module.__name__
        '$Module'
    """
    target = _LAZY.get(name)
    if target is None:
        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
    module_name, attr_name = target
    import importlib

    value = getattr(importlib.import_module(module_name), attr_name)
    globals()[name] = value  # cache: subsequent access skips __getattr__
    return value


def __dir__() -> list[str]:
    return sorted(__all__)
